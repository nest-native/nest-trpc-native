{
  "name": "nest-trpc-native-sample-03-context",
  "version": "0.0.0",
  "private": true,
  "description": "Sample 03 - Context creation and request-scoped providers",
  "license": "MIT",
  "scripts": {
    "clean": "rimraf dist src/@generated",
    "generate:types": "ts-node --transpile-only src/generate-types.ts",
    "typecheck": "npm run generate:types && tsc --noEmit -p tsconfig.json",
    "smoke": "npm run generate:types && ts-node --transpile-only scripts/smoke.ts",
    "test": "npm run typecheck && npm run smoke",
    "start": "npm run generate:types && ts-node src/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@trpc/client": "^11.18.0",
    "@trpc/server": "^11.16.0",
    "@nest-native/trpc": "0.7.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
